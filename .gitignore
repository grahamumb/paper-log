__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# generated journals
*.pdf
*.manifest.json

# ...except the committed sample, which is meant to be printed. The manifest is
# not optional baggage: without it a photograph of a page cannot be turned back
# into a page, so the two have to travel together.
!examples/printable/*.pdf
!examples/printable/*.manifest.json
